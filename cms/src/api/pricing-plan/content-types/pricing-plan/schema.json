{
  "kind": "collectionType",
  "collectionName": "pricing_plans",
  "info": {
    "singularName": "pricing-plan",
    "pluralName": "pricing-plans",
    "displayName": "Pricing Plan",
    "description": "Membership and room pricing plans"
  },
  "config": {
    "layouts": {
      "list": [
        "name",
        "planType",
        "price",
        "isPopular"
      ]
    }
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "planType": {
      "type": "enumeration",
      "enum": [
        "coworking",
        "meeting-room"
      ],
      "default": "coworking"
    },
    "price": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "period": {
      "type": "enumeration",
      "enum": [
        "day",
        "week",
        "month",
        "year"
      ],
      "default": "month"
    },
    "description": {
      "type": "text",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "planType"
            },
            "meeting-room"
          ]
        }
      }
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "common.text-item",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "planType"
            },
            "meeting-room"
          ]
        }
      }
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 1
    }
  }
}
