{
  "kind": "collectionType",
  "collectionName": "meeting_rooms",
  "info": {
    "singularName": "meeting-room",
    "pluralName": "meeting-rooms",
    "displayName": "Meeting Room",
    "description": "Bookable rooms and spaces"
  },
  "config": {
    "layouts": {
      "list": [
        "name",
        "capacity",
        "sortOrder",
        "isFeatured"
      ]
    },
    "metadatas": {
      "isFeatured": {
        "list": {
          "label": "Featured",
          "sortable": true
        }
      }
    }
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "richtext"
    },
    "capacity": {
      "type": "integer"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "common.text-item"
    },
    "badges": {
      "type": "component",
      "repeatable": true,
      "component": "common.text-item"
    },
    "sortOrder": {
      "type": "integer",
      "default": 1
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageUrl": {
      "type": "string"
    }
  }
}
