{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "News and article posts for the website blog"
  },
  "config": {
    "layouts": {
      "list": [
        "title",
        "category",
        "publishedDate",
        "featured"
      ]
    },
    "metadatas": {
      "featured": {
        "list": {
          "label": "Featured",
          "sortable": true
        }
      }
    }
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "contentImages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "contentImageUrls": {
      "type": "json",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "proTipTitle": {
      "type": "string"
    },
    "proTipText": {
      "type": "text"
    },
    "category": {
      "type": "string",
      "required": true
    },
    "publishedDate": {
      "type": "date"
    },
    "readTime": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "common.text-item"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "coverImageUrl": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "seoDescription": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    }
  }
}
