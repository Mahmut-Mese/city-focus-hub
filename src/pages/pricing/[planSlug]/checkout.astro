---
import Layout from '@/layouts/Layout.astro';
import MembershipCheckoutApp from '@/islands/MembershipCheckoutApp';

export async function getStaticPaths() {
  // Fallback slugs used if the backend is unreachable during build
  const fallbackSlugs = ['smart-office', 'full-space', 'lounge1', 'virtual-office', 'hot-desk', 'dedicated-desk'];

  const slugs = new Set<string>();

  try {
    const response = await fetch('http://127.0.0.1:3001/api/public/plans', {
      signal: AbortSignal.timeout(5000),
    });
    if (response.ok) {
      const json = await response.json();
      const plans: Array<{ slug: string }> = json.data || [];
      for (const plan of plans) {
        if (plan.slug) slugs.add(plan.slug);
      }
    }
  } catch {
    // Backend unreachable during build — use fallback slugs
  }

  // Always ensure fallback slugs are included so the build never misses a known plan
  for (const slug of fallbackSlugs) {
    slugs.add(slug);
  }

  return [...slugs].map((slug) => ({ params: { planSlug: slug } }));
}
---
<Layout title="Checkout" description="Complete your membership purchase at City Focus Hub." hideNavigation={true} hideFooter={true}>
  <MembershipCheckoutApp client:only="react" />
</Layout>
