---
import Layout from '@/layouts/Layout.astro';
import MeetingRoomBookingApp from '@/islands/MeetingRoomBookingApp';

export async function getStaticPaths() {
  // Generate booking pages from the resources DB (single source of truth for bookable rooms).
  // Falls back to CMS snapshot only if the backend is unreachable at build time.
  try {
    const backendUrl = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:3001';
    const response = await fetch(`${backendUrl}/api/public/meeting-rooms/resources`);
    if (response.ok) {
      const payload = await response.json();
      const resources = payload?.data?.resources || [];
      const meetingRooms = resources.filter((r: any) => r.type === 'meeting_room');
      if (meetingRooms.length > 0) {
        return meetingRooms.map((r: any) => ({
          params: { roomSlug: r.slug },
        }));
      }
    }
  } catch {
    // Backend unavailable at build time — fall back to CMS snapshot
  }

  // Fallback: read CMS snapshot
  const fs = await import('node:fs');
  const path = await import('node:path');
  const filePath = path.join(process.cwd(), 'public', 'cms', 'meeting-rooms.json');

  try {
    const raw = fs.readFileSync(filePath, 'utf-8');
    const cms = JSON.parse(raw);
    const rooms = cms.data || [];
    return rooms.map((room: any) => ({
      params: { roomSlug: room.slug || String(room.id) },
    }));
  } catch {
    return [{ params: { roomSlug: 'default' } }];
  }
}
---
<Layout title="Book a Meeting Room" description="Reserve a meeting room at City Focus Hub." hideNavigation={true} hideFooter={true}>
  <MeetingRoomBookingApp client:only="react" />
</Layout>
