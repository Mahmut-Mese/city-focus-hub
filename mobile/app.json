{
  "expo": {
    "name": "The Leadenhall Works",
    "slug": "the-leadenhall-works",
    "scheme": "leadenhallworks",
    "version": "1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.leadenhallworks.mobile",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.leadenhallworks.mobile",
            "CFBundleURLSchemes": [
              "leadenhallworks"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.leadenhallworks.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E7E3DA",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "leadenhallworks"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 11
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@sentry/react-native"
    ],
    "extra": {
      "apiUrl": "https://hotpink-oyster-552591.hostingersite.com",
      "stagingApiUrl": "https://staging-api.leadenhallworks.com",
      "eas": {
        "projectId": "857a6042-376f-4be9-9eee-d9f97b12de70"
      }
    },
    "owner": "mahmutmese"
  }
}
